{
  "name": "grimoire-dream-map-desktop",
  "productName": "Grimoire - Dream Map",
  "version": "0.1.1",
  "description": "Grimoire - Dream Map (application PC)",
  "author": "Grimoire",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.pinkrain.grimoire.dreammap",
    "productName": "Grimoire - Dream Map",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../assets/icon.png",
      "artifactName": "Grimoire-Dream-Map-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grimoire - Dream Map",
      "language": "1036"
    },
    "linux": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
